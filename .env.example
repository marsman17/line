# Copy to .env for Docker Compose. Use .env.local for local Next development.
# Production: point APP_DOMAIN DNS to your server and use its HTTPS origin.
APP_URL=https://queue.your-restaurant.com
APP_DOMAIN=queue.your-restaurant.com
RESTAURANT_NAME=The Olive Table
RESTAURANT_ADDRESS=24 Garden Avenue
RESTAURANT_CAPACITY=50
# First production startup creates this account. Never deploy local dev credentials.
ADMIN_EMAIL=manager@your-restaurant.com
ADMIN_PASSWORD=
# Optional for a non-container launch; Docker overrides this to /app/data/tableq.sqlite.
DATABASE_PATH=./data/tableq.sqlite
# Set true ONLY behind a reverse proxy that replaces X-Forwarded-For.
TRUST_PROXY=false
# Browser push: generate with npx web-push generate-vapid-keys. Requires HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# SMS: use a real Twilio account, SMS-enabled sender, and international phone numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
