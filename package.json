{
  "name": "tableq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "NODE_ENV=production tsx scripts/bootstrap.ts && next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup": "tsx scripts/setup.ts",
    "worker": "tsx scripts/worker.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "local": "tsx scripts/local.ts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.21.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
